{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocre.invalid/schemas/eir/mesh-group-manifest-0.1.0.schema.json",
  "title": "OCRE derived mesh group manifest 0.1.0 (experimental)",
  "description": "Structural shape validation for mapping semantic groups from a source geometry to a mesher/solver artifact. Cross-reference resolution, filesystem URI confinement, coordinate tolerance semantics, and solver-specific correctness remain application-level checks.",
  "type": "object",
  "required": ["schema_version", "case_id", "geometry", "mesh", "mesher", "groups"],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "case_id": { "$ref": "#/$defs/identifier" },
    "geometry": { "$ref": "#/$defs/sourceArtifact" },
    "mesh": {
      "type": "object",
      "required": ["artifact", "revision_id"],
      "properties": {
        "artifact": { "$ref": "#/$defs/artifact" },
        "revision_id": { "$ref": "#/$defs/identifier" },
        "element_type": { "type": "string", "minLength": 1 },
        "element_order": { "type": "integer", "minimum": 1 },
        "node_count": { "type": "integer", "minimum": 0 },
        "element_count": { "type": "integer", "minimum": 0 },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "mesher": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "binary_sha256": { "$ref": "#/$defs/sha256OrPending" },
        "settings": { "type": "object", "additionalProperties": true },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/group" }
    },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256OrPending": {
      "description": "Use null while unresolved. A string must be a real 64-character hexadecimal SHA-256 digest; placeholder text is invalid.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["uri", "sha256", "format"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256OrPending" },
        "format": { "type": "string", "minLength": 1 },
        "format_version": { "type": "string", "minLength": 1 },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "sourceArtifact": {
      "type": "object",
      "required": ["uri", "sha256", "format", "geometry_id", "frame_id"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256OrPending" },
        "format": { "type": "string", "minLength": 1 },
        "format_version": { "type": "string", "minLength": 1 },
        "extensions": { "type": "object", "additionalProperties": true },
        "geometry_id": { "$ref": "#/$defs/identifier" },
        "frame_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "coordinate": {
      "type": "object",
      "required": ["value", "unit", "frame_id"],
      "properties": {
        "value": {
          "type": "array",
          "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}],
          "minItems": 3,
          "maxItems": 3
        },
        "unit": { "type": "string", "minLength": 1 },
        "frame_id": { "$ref": "#/$defs/identifier" }
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["semantic_id", "source", "target", "counts"],
      "properties": {
        "semantic_id": { "$ref": "#/$defs/identifier" },
        "source": {
          "type": "object",
          "required": ["geometry_id", "selection"],
          "properties": {
            "geometry_id": { "$ref": "#/$defs/identifier" },
            "selection": {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "enum": ["physical_group", "geometric_entity", "coordinate_query"] },
                "semantic_name": { "type": "string", "minLength": 1 },
                "selector": { "type": "object", "minProperties": 1, "additionalProperties": true },
                "coordinate": { "$ref": "#/$defs/coordinate" },
                "tolerance": { "type": "number", "minimum": 0 },
                "gmsh_entities": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["dimension", "tag"],
                    "properties": {
                      "dimension": { "type": "integer", "minimum": 0, "maximum": 3 },
                      "tag": { "type": "integer", "minimum": 1 }
                    },
                    "additionalProperties": false
                  }
                },
                "extensions": { "type": "object", "additionalProperties": true }
              },
              "allOf": [
                {
                  "if": { "properties": { "kind": { "const": "physical_group" } }, "required": ["kind"] },
                  "then": { "required": ["semantic_name"] }
                },
                {
                  "if": { "properties": { "kind": { "const": "geometric_entity" } }, "required": ["kind"] },
                  "then": { "required": ["selector"] }
                },
                {
                  "if": { "properties": { "kind": { "const": "coordinate_query" } }, "required": ["kind"] },
                  "then": { "required": ["coordinate", "tolerance"] }
                }
              ],
              "additionalProperties": false
            },
            "extensions": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "required": ["set_type", "name"],
          "properties": {
            "set_type": { "enum": ["node_set", "element_set", "surface_set", "other"] },
            "name": { "type": "string", "minLength": 1 },
            "extensions": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        },
        "counts": {
          "type": "object",
          "required": ["expected", "observed"],
          "properties": {
            "expected": { "type": "integer", "minimum": 0 },
            "observed": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "resolved_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "coordinate"],
            "properties": {
              "node_id": { "type": "integer", "minimum": 1 },
              "coordinate": { "$ref": "#/$defs/coordinate" }
            },
            "additionalProperties": false
          }
        },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
