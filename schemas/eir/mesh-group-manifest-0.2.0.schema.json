{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocre.invalid/schemas/eir/mesh-group-manifest-0.2.0.schema.json",
  "title": "OCRE Mesh Group Manifest 0.2.0",
  "description": "Semantic-to-mesh group mapping. Artifact bytes and metadata are referenced only by IDs resolved in the immutable input bundle.",
  "type": "object",
  "required": ["manifest_schema_version", "manifest_id", "revision_id", "case_id", "geometry_id", "source_artifact_id", "mesh_artifact_id", "mesher", "mesh", "groups"],
  "properties": {
    "manifest_schema_version": {"const": "0.2.0"},
    "manifest_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"},
    "case_id": {"$ref": "#/$defs/id"}, "geometry_id": {"$ref": "#/$defs/id"},
    "source_artifact_id": {"$ref": "#/$defs/id"}, "mesh_artifact_id": {"$ref": "#/$defs/id"},
    "mesher": {"type": "object", "required": ["adapter_id", "version", "binary_sha256"], "properties": {"adapter_id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "settings": {"type": "object"}, "extensions": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
    "mesh": {"type": "object", "required": ["element_type", "element_order", "node_count", "element_count"], "properties": {"element_type": {"type": "string", "minLength": 1}, "element_order": {"type": "integer", "minimum": 1}, "node_count": {"type": "integer", "minimum": 1}, "element_count": {"type": "integer", "minimum": 1}, "extensions": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
    "groups": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/group"}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "group": {
      "type": "object", "required": ["semantic_id", "source", "target", "counts"],
      "properties": {
        "semantic_id": {"$ref": "#/$defs/id"},
        "source": {"type": "object", "required": ["selection_kind", "selector"], "properties": {"selection_kind": {"enum": ["physical_group", "geometric_entity", "coordinate_query"]}, "selector": {"type": "object", "minProperties": 1}, "extensions": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
        "target": {"type": "object", "required": ["set_type", "name"], "properties": {"set_type": {"enum": ["node_set", "element_set", "surface_set"]}, "name": {"type": "string", "minLength": 1}, "extensions": {"type": "object", "additionalProperties": true}}, "additionalProperties": false},
        "counts": {"type": "object", "required": ["expected", "observed"], "properties": {"expected": {"type": "integer", "minimum": 0}, "observed": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "extensions": {"type": "object", "additionalProperties": true}
      }, "additionalProperties": false
    }
  }
}
