{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocre.invalid/schemas/eir/0.1.0.schema.json",
  "title": "OCRE Engineering Intermediate Representation 0.1.0 (experimental)",
  "description": "Structural shape validation for the initial axial-bar EIR proposal. This schema does not validate cross-references, URI confinement, UCUM semantics, or revision canonicalization.",
  "type": "object",
  "required": [
    "eir_schema_version",
    "project",
    "revision",
    "geometry",
    "materials",
    "simulation_cases"
  ],
  "properties": {
    "eir_schema_version": { "const": "0.1.0" },
    "project": { "$ref": "#/$defs/project" },
    "revision": { "$ref": "#/$defs/revision" },
    "geometry": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/geometryRef" }
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/material" }
    },
    "simulation_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/simulationCase" }
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension point for fields outside this experimental core schema.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256OrPending": {
      "description": "Use null while the digest is unresolved. A string must be a real 64-character hexadecimal SHA-256 digest; placeholder text is invalid.",
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      ]
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "required": ["project_id"],
      "properties": {
        "project_id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "default_units": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "revision": {
      "type": "object",
      "required": ["revision_id", "project_id", "parent_revision_ids", "manifest_sha256"],
      "properties": {
        "revision_id": { "$ref": "#/$defs/identifier" },
        "project_id": { "$ref": "#/$defs/identifier" },
        "parent_revision_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256OrPending" },
        "created_at": { "type": "string", "format": "date-time" },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "artifactRef": {
      "type": "object",
      "required": ["uri", "sha256", "format"],
      "properties": {
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256OrPending" },
        "format": { "type": "string", "minLength": 1 },
        "format_version": { "type": "string", "minLength": 1 },
        "mime_type": { "type": "string", "minLength": 1 },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "geometryRef": {
      "type": "object",
      "required": ["geometry_id", "artifact", "length_unit", "frame_id"],
      "properties": {
        "geometry_id": { "$ref": "#/$defs/identifier" },
        "artifact": { "$ref": "#/$defs/artifactRef" },
        "length_unit": { "type": "string", "minLength": 1 },
        "frame_id": { "$ref": "#/$defs/identifier" },
        "bounding_box": {
          "type": "object",
          "required": ["min", "max", "unit"],
          "properties": {
            "min": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 3, "maxItems": 3 },
            "max": { "type": "array", "prefixItems": [{"type":"number"},{"type":"number"},{"type":"number"}], "minItems": 3, "maxItems": 3 },
            "unit": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "required": ["material_id", "model", "properties"],
      "properties": {
        "material_id": { "$ref": "#/$defs/identifier" },
        "model": { "type": "string", "minLength": 1 },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/quantity" }
        },
        "provenance": { "type": "object", "additionalProperties": true },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "componentQuantities": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "x": { "$ref": "#/$defs/quantity" },
        "y": { "$ref": "#/$defs/quantity" },
        "z": { "$ref": "#/$defs/quantity" }
      },
      "additionalProperties": false
    },
    "boundaryCondition": {
      "type": "object",
      "required": ["kind", "components"],
      "properties": {
        "group": { "$ref": "#/$defs/identifier" },
        "selection_ref": { "$ref": "#/$defs/identifier" },
        "kind": { "type": "string", "minLength": 1 },
        "components": { "$ref": "#/$defs/componentQuantities" },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "oneOf": [
        { "required": ["group"], "not": { "required": ["selection_ref"] } },
        { "required": ["selection_ref"], "not": { "required": ["group"] } }
      ],
      "additionalProperties": false
    },
    "simulationCase": {
      "type": "object",
      "required": ["case_id", "revision_id", "domain", "analysis", "frame_id", "groups", "group_manifest_ref", "loads", "constraints", "solver"],
      "properties": {
        "case_id": { "$ref": "#/$defs/identifier" },
        "revision_id": { "$ref": "#/$defs/identifier" },
        "domain": { "type": "string", "minLength": 1 },
        "analysis": { "type": "string", "minLength": 1 },
        "frame_id": { "$ref": "#/$defs/identifier" },
        "groups": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "group_manifest_ref": { "type": "string", "minLength": 1 },
        "loads": { "type": "array", "items": { "$ref": "#/$defs/boundaryCondition" } },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/boundaryCondition" } },
        "solver": {
          "type": "object",
          "required": ["adapter_id"],
          "properties": {
            "adapter_id": { "$ref": "#/$defs/identifier" },
            "proposed_target_version": { "type": "string", "minLength": 1 },
            "extensions": { "type": "object", "additionalProperties": true }
          },
          "additionalProperties": false
        },
        "extensions": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    }
  }
}
