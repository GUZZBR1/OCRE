{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ocre.invalid/schemas/eir/input-bundle-0.2.0.schema.json",
  "title": "OCRE Immutable Input Bundle Manifest 0.2.0",
  "description": "The sole source of artifact URI, media type, format, and content hash for an input bundle. URI confinement and digest verification are semantic checks.",
  "type": "object",
  "required": ["bundle_schema_version", "bundle_id", "eir_artifact_id", "artifacts"],
  "properties": {
    "bundle_schema_version": {"const": "0.2.0"},
    "bundle_id": {"$ref": "#/$defs/id"},
    "eir_artifact_id": {"$ref": "#/$defs/id"},
    "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}},
    "extensions": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha256OrNull": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-f0-9]{64}$"}]},
    "artifact": {
      "type": "object", "required": ["artifact_id", "uri", "media_type", "format", "sha256", "usage"],
      "properties": {
        "artifact_id": {"$ref": "#/$defs/id"},
        "uri": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$"},
        "format": {"type": "string", "minLength": 1},
        "format_version": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256OrNull"},
        "usage": {"enum": ["required", "optional"]},
        "extensions": {"type": "object", "additionalProperties": true}
      }, "additionalProperties": false
    }
  }
}
